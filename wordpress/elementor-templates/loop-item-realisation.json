{
  "version": "0.4",
  "title": "Loop Item — Réalisation Althium",
  "type": "loop-item",
  "content": [
    {
      "id": "container_loop_real",
      "elType": "container",
      "settings": {
        "content_width": "full",
        "min_height": { "unit": "px", "size": 320 },
        "border_radius": { "unit": "px", "top": 12, "right": 12, "bottom": 12, "left": 12 },
        "overflow": "hidden",
        "background_background": "classic",
        "background_color": "#0C2E63",
        "background_overlay_background": "gradient",
        "background_overlay_color": "rgba(12, 46, 99, 0.1)",
        "background_overlay_color_b": "rgba(12, 46, 99, 0.9)",
        "padding": { "unit": "px", "top": 20, "right": 20, "bottom": 20, "left": 20 },
        "flex_direction": "column",
        "justify_content": "flex-end",
        "css_classes": "ratio-realisation"
      },
      "elements": [
        {
          "id": "w_loop_real_kpi",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "[acf field='realisation_kpi']",
            "header_size": "span",
            "title_color": "#1E9FE0",
            "typography_font_family": "Sora",
            "typography_font_size": { "unit": "px", "size": 13 },
            "typography_font_weight": "700"
          }
        },
        {
          "id": "w_loop_real_title",
          "elType": "widget",
          "widgetType": "theme-post-title",
          "settings": {
            "title_color": "#FFFFFF",
            "typography_font_family": "Sora",
            "typography_font_size": { "unit": "px", "size": 18 },
            "typography_font_weight": "700"
          }
        }
      ]
    }
  ]
}
