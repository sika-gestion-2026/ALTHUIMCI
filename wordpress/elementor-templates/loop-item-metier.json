{
  "version": "0.4",
  "title": "Loop Item — Métier Althium",
  "type": "loop-item",
  "content": [
    {
      "id": "container_loop_metier",
      "elType": "container",
      "settings": {
        "content_width": "full",
        "min_height": { "unit": "px", "size": 420 },
        "padding": { "unit": "px", "top": 30, "right": 25, "bottom": 30, "left": 25 },
        "border_radius": { "unit": "px", "top": 16, "right": 16, "bottom": 16, "left": 16 },
        "overflow": "hidden",
        "background_background": "classic",
        "background_color": "#0C2E63",
        "background_overlay_background": "gradient",
        "background_overlay_color": "rgba(12, 46, 99, 0.2)",
        "background_overlay_color_b": "rgba(12, 46, 99, 0.92)",
        "flex_direction": "column",
        "justify_content": "flex-end",
        "css_classes": "althium-card-metier ratio-card-metier"
      },
      "elements": [
        {
          "id": "w_loop_title",
          "elType": "widget",
          "widgetType": "theme-post-title",
          "settings": {
            "title_color": "#FFFFFF",
            "typography_font_family": "Sora",
            "typography_font_size": { "unit": "px", "size": 22 },
            "typography_font_weight": "700"
          }
        },
        {
          "id": "w_loop_subtitle",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "[acf field='pole_subtitle']",
            "text_color": "#E2E8F0"
          }
        },
        {
          "id": "w_loop_link",
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "Découvrir le pôle →",
            "link": { "url": "[post_url]" },
            "background_color": "transparent",
            "button_text_color": "#1E9FE0",
            "typography_font_family": "Sora",
            "typography_font_weight": "700"
          }
        }
      ]
    }
  ]
}
