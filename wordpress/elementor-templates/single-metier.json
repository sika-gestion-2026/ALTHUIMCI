{
  "version": "0.4",
  "title": "Single Template — Métiers Althium",
  "type": "single-post",
  "content": [
    {
      "id": "sec_hero_metier",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "background_background": "classic",
        "background_color": "#0C2E63",
        "padding": { "unit": "px", "top": 120, "bottom": 90 }
      },
      "elements": [
        {
          "id": "col_hero_metier",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "w_tag_pole",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "PÔLE D'EXPERTISE ALTHIUM",
                "header_size": "span",
                "title_color": "#1E9FE0",
                "typography_font_family": "Sora",
                "typography_font_size": { "unit": "px", "size": 14 },
                "typography_font_weight": "700"
              }
            },
            {
              "id": "w_post_title",
              "elType": "widget",
              "widgetType": "theme-post-title",
              "settings": {
                "title_color": "#FFFFFF",
                "typography_font_family": "Sora",
                "typography_font_size": { "unit": "px", "size": 52 },
                "typography_font_weight": "800"
              }
            },
            {
              "id": "w_acf_subtitle",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "[acf field='pole_subtitle']",
                "text_color": "#E2E8F0"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "sec_services_metier",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "padding": { "unit": "px", "top": 80, "bottom": 80 }
      },
      "elements": [
        {
          "id": "col_services_metier",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "w_title_services",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Nos Prestations & Domaines d'Intervention",
                "header_size": "h2",
                "title_color": "#0C2E63",
                "typography_font_family": "Sora"
              }
            },
            {
              "id": "w_post_content",
              "elType": "widget",
              "widgetType": "theme-post-content",
              "settings": {}
            }
          ]
        }
      ]
    },
    {
      "id": "sec_cta_metier",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "background_background": "classic",
        "background_color": "#F4F6F9",
        "padding": { "unit": "px", "top": 60, "bottom": 60 }
      },
      "elements": [
        {
          "id": "col_cta_metier",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "w_cta_title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Un projet dans ce secteur ?",
                "header_size": "h3",
                "align": "center",
                "title_color": "#0C2E63",
                "typography_font_family": "Sora"
              }
            },
            {
              "id": "w_cta_btn",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "Demander une étude personnalisée",
                "align": "center",
                "link": { "url": "#elementor-action:action=popup:open&settings=eyJpZCI6ImRldmlzLXBvcHVwIn0=" },
                "background_color": "#C41230"
              }
            }
          ]
        }
      ]
    }
  ]
}
